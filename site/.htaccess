# The Relational Practice — Concept (static demo)
# Stop rewrite rules inherited from the parent WordPress site from applying here.
RewriteEngine On

DirectoryIndex index.html
ErrorDocument 404 /404.html
Options -Indexes

<IfModule mod_headers.c>
  # Demo site: keep out of search results (also set per page with a meta tag).
  Header set X-Robots-Tag "noindex, nofollow"
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  <FilesMatch "\.(html)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=600"
  </FilesMatch>
  <FilesMatch "\.(webp|jpg|svg|woff2)$">
    Header set Cache-Control "public, max-age=31536000"
  </FilesMatch>
</IfModule>

<IfModule mod_mime.c>
  AddType font/woff2 .woff2
  AddType image/webp .webp
</IfModule>
